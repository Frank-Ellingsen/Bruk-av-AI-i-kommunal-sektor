.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# SQLite temporary runtime files
*.db-journal
*.db-wal
*.db-shm

# Environment files
.env
.env.*
!.env.example

# Generated artifacts (keep folder structure but ignore runtime output)
artifacts/*
!artifacts/.gitkeep
!artifacts/reports/
artifacts/reports/*
